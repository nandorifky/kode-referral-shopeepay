---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

// Mengambil props dari file markdown/mdx
type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage, tags, seo, extraSchema } = Astro.props;

// --- LOGIKA SEO ---
const metaTitle = (seo?.discriminant && seo.value?.metaTitle) ? seo.value.metaTitle : title;
const metaDesc = (seo?.discriminant && seo.value?.metaDescription) ? seo.value.metaDescription : description;
const noIndex = (seo?.discriminant && seo.value?.noIndex);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": metaTitle,
  "description": metaDesc,
  "image": heroImage?.src ? new URL(heroImage.src, Astro.site).toString() : undefined,
  "datePublished": pubDate.toISOString(),
  "dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": "Nando Rifky",
    "url": "https://nandorifky.web.id"
  }
};
---

<html lang="id">
	<head>
		<BaseHead title={metaTitle} description={metaDesc} />
        {noIndex && <meta name="robots" content="noindex, nofollow" />}
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        {extraSchema && <script type="application/ld+json" set:html={extraSchema} />}
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@700;800&display=swap" rel="stylesheet">
        <script src="https://unpkg.com/@phosphor-icons/web"></script>

        <style>
            /* --- DARK MODE GLOBAL --- */
            body {
                background-color: #050505;
                color: #e0e0e0;
                font-family: 'Inter', sans-serif;
                background-image: 
                    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
                background-size: 40px 40px;
            }
            .font-display { font-family: 'Outfit', sans-serif; }
            html { scroll-behavior: smooth; }
        </style>
	</head>

	<body class="antialiased selection:bg-[#EE4D2D] selection:text-white">
		<Header />
		
        <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16">
            
            <nav class="flex text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/" class="hover:text-[#EE4D2D] transition-colors flex items-center gap-1">
                            <i class="ph-bold ph-house"></i> Home
                        </a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <i class="ph-bold ph-caret-right text-gray-600"></i>
                            <a href="/blog" class="ml-1 hover:text-[#EE4D2D] transition-colors">Blog</a>
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <i class="ph-bold ph-caret-right text-gray-600"></i>
                            <span class="ml-1 text-gray-300 font-medium truncate max-w-[150px] md:max-w-xs">{title}</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <article class="bg-[#121212] border border-white/10 rounded-2xl overflow-hidden shadow-2xl">
                
                {heroImage && (
                    <div class="relative w-full">
                        <div class="aspect-video md:aspect-[21/9] overflow-hidden bg-gray-900">
                            <img 
                                src={heroImage.src} 
                                alt={heroImage.alt || title} 
                                class="w-full h-full object-cover"
                                loading="eager"
                            />
                        </div>
                        {heroImage.caption && (
                            <div class="bg-black/50 py-2 px-4 border-b border-white/5">
                                <p class="text-center text-xs text-gray-500 italic flex items-center justify-center gap-1">
                                    <i class="ph-fill ph-camera"></i> {heroImage.caption}
                                </p>
                            </div>
                        )}
                    </div>
                )}

                <div class="p-6 md:p-10">
                    {tags && tags.length > 0 && (
                        <div class="flex flex-wrap gap-2 mb-4">
                            {tags.map(tag => (
                                <span class="bg-[#EE4D2D]/10 text-[#EE4D2D] border border-[#EE4D2D]/20 text-[10px] uppercase font-bold px-2 py-1 rounded-md">
                                    #{tag}
                                </span>
                            ))}
                        </div>
                    )}

                    <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 mb-6">
                        <div class="flex items-center gap-1.5">
                            <i class="ph-duotone ph-calendar-blank text-lg text-[#EE4D2D]"></i>
                            <FormattedDate date={pubDate} />
                        </div>
                        {updatedDate && (
                            <div class="flex items-center gap-1.5 bg-yellow-500/10 text-yellow-500 px-2 py-0.5 rounded-full text-xs font-medium border border-yellow-500/20">
                                <i class="ph-duotone ph-arrows-clockwise"></i>
                                Updated: <FormattedDate date={updatedDate} />
                            </div>
                        )}
                    </div>

                    <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-white leading-tight mb-8">
                        {title}
                    </h1>

                    <hr class="border-white/10 mb-8" />

                    <div class="prose prose-lg prose-invert max-w-none 
                        prose-headings:font-display prose-headings:font-bold prose-headings:text-white
                        prose-p:text-gray-300
                        prose-a:text-[#EE4D2D] prose-a:no-underline hover:prose-a:underline
                        prose-img:rounded-xl prose-img:shadow-lg prose-img:border prose-img:border-white/10
                        prose-strong:text-white
                        prose-blockquote:border-l-4 prose-blockquote:border-[#EE4D2D] prose-blockquote:bg-[#EE4D2D]/10 prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-blockquote:text-gray-200 prose-blockquote:not-italic">
                        <slot />
                    </div>
                </div>

                <div class="bg-black/30 border-t border-white/5 p-6 md:p-8 mt-8">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-[#EE4D2D] shadow-sm shrink-0">
                             <img src="https://nandorifky.web.id/assets/images/nando%20rifky.jpg" alt="Nando Rifky" class="w-full h-full object-cover">
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-0.5">Ditulis Oleh</p>
                            <h3 class="text-lg font-bold text-white">Nando Rifky</h3>
                            <p class="text-sm text-gray-400 mt-1">Halaman ini dikelola oleh <span class="text-shopee">Nando Rifky</span>, selaku SEO Specialist, Tech Enthusiast, dan pengguna ShopeePay sejak 2019. Saya membuat halaman ini untuk mempermudah teman-teman mendapatkan bonus pengguna baru yang valid, serta untuk eksperimen pribadi saya tentang SEO. </p>
                        </div>
                    </div>
                </div>

            </article>

            <div id="sticky-cta" class="md:hidden fixed bottom-4 left-4 right-4 bg-[#121212]/95 backdrop-blur-xl text-white p-4 rounded-xl shadow-2xl border border-white/10 z-50 transform translate-y-[150%] transition-transform duration-300">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex-1">
                        <p class="text-[10px] text-gray-400 uppercase font-bold">Kode Referral ShopeePay:</p>
                        <code class="font-mono text-lg font-bold text-[#EE4D2D]">JL3D5DYVW</code>
                    </div>
                    <button onclick="navigator.clipboard.writeText('JL3D5DYVW'); alert('Kode berhasil disalin!');" class="bg-[#EE4D2D] hover:bg-orange-600 text-white text-xs font-bold px-4 py-2.5 rounded-lg shadow-lg active:scale-95 transition-transform">
                        SALIN
                    </button>
                </div>
            </div>

        </main>
		<Footer />
        
        <script is:inline>
            const cta = document.getElementById('sticky-cta');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 400) {
                    cta?.classList.remove('translate-y-[150%]');
                } else {
                    cta?.classList.add('translate-y-[150%]');
                }
            });
        </script>
	</body>
</html>