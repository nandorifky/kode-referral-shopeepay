---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="sticky top-0 z-50 w-full border-b border-white/5 bg-[#0a0a0a]/90 backdrop-blur-xl transition-all duration-300">
    <div class="max-w-6xl mx-auto px-4 md:px-6 h-16 flex items-center justify-between">
        
        <a href="/" class="flex items-center gap-2 group text-decoration-none">
            <div class="bg-shopee text-white p-1.5 rounded-lg group-hover:rotate-12 transition-transform">
                <i class="ph-bold ph-wallet text-xl"></i>
            </div>
            <div class="font-display font-bold text-lg md:text-xl tracking-tight text-white">
                ShopeePay <span class="text-shopee">Referral</span>
            </div>
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-400">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <a href="/blog" class="hover:text-white transition-colors">Blog</a>
            <a href="https://shopeepayreferral.web.id/#cara-klaim" class="hover:text-white transition-colors">Cara Klaim</a>
        </nav>

        <div class="hidden md:block">
            <button onclick="navigator.clipboard.writeText('JL3D5DYVW'); alert('Kode berhasil disalin!')"
               class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-full text-xs font-bold border border-white/10 transition-all flex items-center gap-2 cursor-pointer">
                <i class="ph-bold ph-copy"></i> JL3D5DYVW
            </button>
        </div>
        
        <button id="mobile-menu-btn" class="md:hidden text-gray-400 hover:text-white p-2 focus:outline-none">
            <i class="ph-bold ph-list text-2xl"></i>
        </button>
    </div>

    <div id="mobile-menu" class="hidden md:hidden border-t border-white/5 bg-[#0a0a0a]">
        <nav class="flex flex-col p-4 gap-4 text-sm font-medium text-gray-400">
            <a href="/" class="hover:text-white">Home</a>
            <a href="/blog" class="hover:text-white">Blog</a>
            <a href="https://shopeepayreferral.web.id/#cara-klaim" class="hover:text-white">Cara Klaim</a>
        </nav>
    </div>
</header>

<script>
    // Script simpel untuk toggle menu mobile
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    
    if (btn && menu) {
        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });
    }
</script>

<style>
    /* Pastikan link tidak ada garis bawah default */
    a { text-decoration: none; }
</style>