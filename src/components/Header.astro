---
import { SITE_TITLE } from '../consts';
---

<nav class="sticky top-0 z-40 glass-strong w-full transition-all duration-300" id="navbar">
    <div class="max-w-6xl mx-auto px-4 md:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group decoration-transparent">
            <div class="bg-shopee text-white p-1.5 rounded-lg group-hover:rotate-12 transition-transform">
                <i class="ph-bold ph-wallet text-xl"></i>
            </div>
            <div class="font-display font-bold text-lg md:text-xl tracking-tight text-white">
                ShopeePay <span class="text-shopee">Referral</span>
            </div>
        </a>

        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-400">
            <a href="/#kode" class="hover:text-white text-shopee transition-colors decoration-transparent">Kode Referral</a>
            <a href="/blog" class="hover:text-white hover:text-shopee transition-colors decoration-transparent relative group">
                Blog
                <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-shopee transition-all group-hover:w-full"></span>
            </a>
            <a href="/#event-info" class="relative group hover:text-white transition-colors flex items-center gap-2 decoration-transparent">
                <span>Event Terbaru</span>
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-shopee opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-shopee"></span>
                </span>
            </a>
            <a href="/#free-transfer" class="hover:text-white hover:text-shopee transition-colors decoration-transparent">Gratis Transfer</a>
            <a href="/#cara-klaim" class="hover:text-white hover:text-shopee transition-colors decoration-transparent">Cara Klaim</a>
        </div>

        <div class="hidden md:block">
            <button
               onclick="copyCode()"
               class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-full text-xs font-bold border border-white/10 transition-all flex items-center gap-2 cursor-pointer no-underline">
                <i class="ph-bold ph-copy"></i> JL3D5DYVW
            </button>
        </div>
        
        <button type="button" aria-label="Buka Menu Navigasi" id="open-menu-btn" class="md:hidden text-gray-400 hover:text-white p-2 focus:outline-none active:scale-95 transition-transform">
            <i class="ph-bold ph-list text-2xl"></i>
        </button>
    </div>

    <div class="md:hidden border-t border-white/5 overflow-x-auto hide-scrollbar bg-black/20 backdrop-blur-md w-full touch-pan-x">
        <div class="flex items-center gap-6 px-4 h-12 text-xs font-medium text-gray-400 min-w-max">
            <a href="/#kode" class="mobile-nav-item text-shopee decoration-transparent">Kode Referral</a>
            <a href="/blog" class="mobile-nav-item text-white font-bold decoration-transparent">Blog</a>
            <a href="/#event-info" class="relative group hover:text-white transition-colors flex items-center gap-2 decoration-transparent">
                <span>Event Terbaru</span>
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-shopee opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-shopee"></span>
                </span>
            </a>
            <a href="/#free-transfer" class="mobile-nav-item decoration-transparent">Gratis Transfer</a>
            <a href="/#cara-klaim" class="mobile-nav-item decoration-transparent">Cara Klaim</a>
        </div>
    </div>
</nav>

<div id="mobile-menu-overlay" class="fixed inset-0 z-[60] hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity" id="overlay-bg"></div>
    
    <div class="absolute right-0 top-0 bottom-0 w-[85%] max-w-[320px] bg-[#050505] border-l border-white/10 shadow-2xl flex flex-col transform transition-transform duration-300 translate-x-full z-[70]" id="mobile-menu-drawer">
        
        <div class="flex justify-between items-center p-6 border-b border-white/5 bg-[#0a0a0a]">
            <div class="flex items-center gap-2">
                <div class="bg-shopee text-white p-1 rounded group-hover:rotate-12 transition-transform">
                    <i class="ph-bold ph-wallet text-lg"></i>
                </div>
                <span class="font-display font-bold text-lg text-white tracking-tight">ShopeePay <span class="text-shopee">Referral</span></span>
            </div>
            <button type="button" aria-label="Tutup Menu" id="close-menu-btn" class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 text-gray-400 hover:text-white hover:bg-white/10 transition-colors border border-white/5">
                <i class="ph-bold ph-x text-lg"></i>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto custom-scrollbar p-5 space-y-6">
            
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-20 h-20 bg-shopee/20 blur-2xl rounded-full -mr-10 -mt-10 pointer-events-none group-hover:bg-shopee/30 transition-colors"></div>
                
                <h3 class="text-[10px] font-bold text-shopee uppercase tracking-widest mb-3 border-b border-white/5 pb-2 flex items-center gap-1.5">
                    <i class="ph-bold ph-lightning"></i> Info Promo Aktif
                </h3>
                
                <ul class="space-y-2.5 text-xs text-gray-300">
                    <li class="flex justify-between items-center">
                        <span class="opacity-70">Kode Undangan:</span>
                        <div class="flex items-center gap-2">
                            <code class="font-mono font-bold text-white bg-black/30 px-2 py-0.5 rounded border border-white/5 text-sm">JL3D5DYVW</code>
                            <button onclick="copyCode()" class="text-gray-400 hover:text-shopee transition-colors"><i class="ph-bold ph-copy"></i></button>
                        </div>
                    </li>
                    <li class="flex justify-between items-center">
                        <span class="opacity-70">Bonus:</span>
                        <span class="text-green-400 font-bold bg-green-500/10 px-2 py-0.5 rounded border border-green-500/20">Rp5.000 + Voucher</span>
                    </li>
                    <li class="flex justify-between items-center">
                        <span class="opacity-70">Status:</span>
                        <span class="text-white flex items-center gap-1.5 font-medium">
                            <span class="relative flex h-2 w-2">
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                            </span>
                            Valid Hari Ini
                        </span>
                    </li>
                </ul>
            </div>

            <div class="space-y-1">
                <p class="text-[10px] text-gray-500 font-bold uppercase tracking-wider mb-2 px-2">Navigasi Halaman</p>
                
                <a href="/#kode" class="mobile-menu-link flex items-center justify-between p-3 rounded-xl text-gray-300 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group decoration-transparent">
                    <div class="flex items-center gap-3">
                        <i class="ph-duotone ph-house text-xl text-gray-500 group-hover:text-shopee transition-colors"></i>
                        <span class="font-medium text-sm">Beranda & Kode</span>
                    </div>
                    <i class="ph-bold ph-caret-right text-gray-600 group-hover:text-white transition-colors"></i>
                </a>

                <a href="/blog" class="mobile-menu-link flex items-center justify-between p-3 rounded-xl text-white bg-white/5 border border-white/10 hover:border-shopee/50 transition-all group decoration-transparent">
                    <div class="flex items-center gap-3">
                        <i class="ph-duotone ph-article text-xl text-shopee group-hover:text-shopee transition-colors"></i>
                        <span class="font-medium text-sm">Artikel & Blog</span>
                    </div>
                    <i class="ph-bold ph-caret-right text-white transition-colors"></i>
                </a>

                <a href="/#event-info" class="mobile-menu-link flex items-center justify-between p-3 rounded-xl text-gray-300 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group decoration-transparent">
                    <div class="flex items-center gap-3">
                        <i class="ph-duotone ph-calendar-star text-xl text-gray-500 group-hover:text-shopee transition-colors"></i>
                        <span class="font-medium text-sm">Info Event</span>
                    </div>
                    <i class="ph-bold ph-caret-right text-gray-600 group-hover:text-white transition-colors"></i>
                </a>

                <a href="/#free-transfer" class="mobile-menu-link flex items-center justify-between p-3 rounded-xl text-gray-300 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group decoration-transparent">
                    <div class="flex items-center gap-3">
                        <i class="ph-duotone ph-arrows-left-right text-xl text-gray-500 group-hover:text-shopee transition-colors"></i>
                        <span class="font-medium text-sm">Gratis Transfer</span>
                    </div>
                    <i class="ph-bold ph-caret-right text-gray-600 group-hover:text-white transition-colors"></i>
                </a>

                <a href="/#cara-klaim" class="mobile-menu-link flex items-center justify-between p-3 rounded-xl text-gray-300 hover:text-white hover:bg-white/5 border border-transparent hover:border-white/5 transition-all group decoration-transparent">
                    <div class="flex items-center gap-3">
                        <i class="ph-duotone ph-check-square text-xl text-gray-500 group-hover:text-shopee transition-colors"></i>
                        <span class="font-medium text-sm">Panduan Klaim</span>
                    </div>
                    <i class="ph-bold ph-caret-right text-gray-600 group-hover:text-white transition-colors"></i>
                </a>
            </div>
        </div>

        <div class="p-6 border-t border-white/5 bg-[#0a0a0a]">
            <a href="https://pay.u.shopee.co.id/5bbddxE"
               target="_blank"
               class="w-full bg-gradient-to-r from-shopee to-orange-600 hover:from-orange-600 hover:to-shopee text-white py-3.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2 cursor-pointer no-underline shadow-lg shadow-shopee/20 transition-all active:scale-95">
                <i class="ph-bold ph-copy-simple"></i> Salin Kode Referral
            </a>
            <p class="text-[10px] text-center text-gray-600 mt-3">
                Berlaku untuk pengguna baru ShopeePay.
            </p>
        </div>
    </div>
</div>

<script is:inline>
    // --- 1. LOGIKA MOBILE MENU DRAWER ---
    const openBtn = document.getElementById('open-menu-btn');
    const closeBtn = document.getElementById('close-menu-btn');
    const overlayBg = document.getElementById('overlay-bg');
    const overlay = document.getElementById('mobile-menu-overlay');
    const drawer = document.getElementById('mobile-menu-drawer');
    const menuLinks = document.querySelectorAll('.mobile-menu-link');

    function toggleMenu() {
        if (overlay.classList.contains('hidden')) {
            // Buka Menu
            overlay.classList.remove('hidden');
            setTimeout(() => drawer.classList.remove('translate-x-full'), 10);
            document.body.style.overflow = 'hidden'; // Stop scroll body
        } else {
            // Tutup Menu
            drawer.classList.add('translate-x-full');
            setTimeout(() => {
                overlay.classList.add('hidden');
                document.body.style.overflow = 'auto'; // Enable scroll
            }, 300);
        }
    }

    if(openBtn) openBtn.addEventListener('click', toggleMenu);
    if(closeBtn) closeBtn.addEventListener('click', toggleMenu);
    if(overlayBg) overlayBg.addEventListener('click', toggleMenu);
    
    // Tutup menu saat link diklik
    menuLinks.forEach(link => {
        link.addEventListener('click', toggleMenu);
    });

    // --- 2. LOGIKA COPY CODE ---
    window.copyCode = function() {
        navigator.clipboard.writeText("JL3D5DYVW").then(() => {
            alert("Kode JL3D5DYVW berhasil disalin!");
        }).catch(err => {
            console.error('Gagal menyalin: ', err);
        });
    }
</script>