    day: "numeric",
    month: "long",
    year: "numeric",
});

// 3. Tambahan Variabel Pecahan (Ini tambahan dari saya untuk Judul & Teks)
const months = [
    "Januari",
    "Februari",
    "Maret",
    "April",
    "Mei",
    "Juni",
    "Juli",
    "Agustus",
    "September",
    "Oktober",
    "November",
    "Desember",
];
const namaBulan = months[now.getMonth()];
const tahunSaja = now.getFullYear();
const bulanTahun = `${namaBulan} ${tahunSaja}`; // Output: "BULAN TAHUN"

// Logika Akhir Bulan
