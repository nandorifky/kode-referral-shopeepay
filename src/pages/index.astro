                                class="w-full bg-transparent hover:bg-white/5 text-gray-500 hover:text-white font-medium py-3 px-6 rounded-xl transition-colors text-sm"
                            >
                                Nanti Saja
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <button
                id="back-to-top"
                onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
                class="fixed bottom-24 right-4 md:bottom-8 md:right-8 z-40 w-10 h-10 md:w-12 md:h-12 bg-white/10 hover:bg-shopee backdrop-blur-md border border-white/20 rounded-full flex items-center justify-center text-white shadow-2xl transition-all duration-300 opacity-0 translate-y-10 pointer-events-none group"
            >
                <i
                    class="ph-bold ph-arrow-up text-xl group-hover:-translate-y-0.5 transition-transform"
                ></i>
            </button>
            <!-- JS LOGIC -->
            <script is:inline>
                /* --- 1. CONFIG & UTILS --- */
                let targetRedirectUrl = "";
                const currentCode = "JL3D5DYVW";

                // Haptic Feedback (Getar di HP saat klik)
                function triggerHaptic() {
                    if (navigator.vibrate) navigator.vibrate(50);
                }

                // Modal Logic (Buka/Tutup)
                function toggleModal(modalID) {
                    const modal = document.getElementById(modalID);
                    const isHidden = modal.classList.contains("hidden");
                    if (isHidden) {
                        modal.classList.remove("hidden");
                        document.body.style.overflow = "hidden";
                    } else {
                        modal.classList.add("hidden");
                        document.body.style.overflow = "auto";
                    }
                }

                function closeConfirmModal() {
                    document
                        .getElementById("modal-confirm-redirect")
                        .classList.add("hidden");
                    document.body.style.overflow = "auto";
                }

                /* --- 2. CORE AFFILIATE LOGIC (Click > Copy > Modal) --- */
                function handleAffiliateClick(e) {
                    e.preventDefault();
                    triggerHaptic(); // Efek getar

                    targetRedirectUrl = e.currentTarget.href;

                    const showConfirm = () => {
                        const modal = document.getElementById(
                            "modal-confirm-redirect",
                        );
                        modal.classList.remove("hidden");
                        document.body.style.overflow = "hidden";
                    };

                    // Logika Copy Universal
                    if (!navigator.clipboard) {
                        // Fallback untuk browser lama
                        const ta = document.createElement("textarea");
                        ta.value = currentCode;
                        ta.style.position = "fixed";
                        ta.style.opacity = "0";
                        document.body.appendChild(ta);
                        ta.select();
                        try {
                            document.execCommand("copy");
                            showConfirm();
                        } catch (err) {
                            showConfirm();
                        }
                        document.body.removeChild(ta);
                    } else {
                        // Browser Modern
                        navigator.clipboard
                            .writeText(currentCode)
                            .then(showConfirm)
                            .catch(showConfirm);
                    }
                }

                // Event Listener Tombol "Buka Shopee" di Modal
                document
                    .getElementById("btn-confirm-yes")
                    .addEventListener("click", function () {
                        triggerHaptic();
                        if (targetRedirectUrl) {
                            window.open(targetRedirectUrl, "_blank");
                            closeConfirmModal();
                        }
                    });

                /* --- 3. COUNTDOWN TIMER (Support Multi-Element Update) --- */
                function startCountdown() {
                    const now = new Date();
                    // Target: Akhir bulan ini, jam 23:59:59
                    const target = new Date(
                        now.getFullYear(),
                        now.getMonth() + 1,
                        0,
                        23,
                        59,
                        59,
                    ).getTime();

                    // Fungsi update teks helper (biar ringkas)
                    const updateText = (id, val) => {
                        // Cari elemen berdasarkan ID (untuk single match)
                        const el = document.getElementById(id);
                        if (el) el.innerText = val;

                        // Cari elemen di dalam Popup juga (jika ID-nya sama, browser cuma ambil satu.
                        // Jadi kita pakai trik QuerySelectorAll jika Anda pakai Class,
                        // tapi jika ID Anda duplikat di HTML, JS hanya update yang pertama.
                        // SOLUSI TERBAIK: Update elemen popup secara spesifik jika ID-nya beda,
                        // atau pastikan HTML Hero sudah dihapus seperti instruksi sebelumnya.)
                    };

                    setInterval(() => {
                        const dist = target - new Date().getTime();
                        if (dist < 0) return;

                        const d = Math.floor(dist / (1000 * 60 * 60 * 24));
                        const h = Math.floor(
                            (dist % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
                        );
                        const m = Math.floor(
                            (dist % (1000 * 60 * 60)) / (1000 * 60),
                        );
                        const s = Math.floor((dist % (1000 * 60)) / 1000);
                        const fmt = (n) => (n < 10 ? "0" + n : n);

                        // Update Timer Utama (Di Popup)
                        // Pastikan HTML di Popup menggunakan ID: cd-days, cd-hours, dst.
                        // DAN Pastikan HTML di Hero Section SUDAH DIHAPUS.

                        if (document.getElementById("cd-seconds")) {
                            document.getElementById("cd-days").innerText =
                                fmt(d);
                            document.getElementById("cd-hours").innerText =
                                fmt(h);
                            document.getElementById("cd-minutes").innerText =
                                fmt(m);
                            document.getElementById("cd-seconds").innerText =
                                fmt(s);
                        }
                    }, 1000);
                }
                startCountdown();

                /* --- 4. UI INTERACTION (Scroll, Navbar, Mobile Menu) --- */
                const backToTop = document.getElementById("back-to-top");
                const nav = document.getElementById("navbar");
                const mobileCta = document.getElementById("mobile-cta");

                window.addEventListener("scroll", () => {
                    const y = window.scrollY;

                    // Tombol Back to top (Muncul setelah scroll 600px)
                    if (y > 600)
                        backToTop.classList.remove(
                            "opacity-0",
                            "translate-y-10",
                            "pointer-events-none",
                        );
                    else
                        backToTop.classList.add(
                            "opacity-0",
                            "translate-y-10",
                            "pointer-events-none",
                        );

                    // Navbar Blur Effect
                    if (y > 50) nav.classList.add("shadow-lg", "bg-black/90");
                    else nav.classList.remove("shadow-lg", "bg-black/90");

                    // Mobile Sticky CTA (Muncul setelah scroll 300px)
                    if (y > 300) mobileCta.classList.remove("translate-y-full");
                    else mobileCta.classList.add("translate-y-full");
                });

                // Toggle Menu Mobile
                function toggleMobileMenu() {
                    const ov = document.getElementById("mobile-menu-overlay");
                    const dr = document.getElementById("mobile-menu-drawer");
                    if (ov.classList.contains("hidden")) {
                        ov.classList.remove("hidden");
                        setTimeout(
                            () => dr.classList.remove("translate-x-full"),
                            10,
                        );
                    } else {
                        dr.classList.add("translate-x-full");
                        setTimeout(() => ov.classList.add("hidden"), 300);
                    }
                }

                // Accordion FAQ Logic
                function toggleAccordion(btn) {
                    const content = btn.nextElementSibling;
                    const icon = btn.querySelector(".ph-caret-down");
                    content.classList.toggle("active");
                    btn.parentElement.classList.toggle("active");
                    icon.style.transform = content.classList.contains("active")
                        ? "rotate(180deg)"
                        : "rotate(0deg)";
                }

                /* --- 5. AUTO DATE UPDATE & DYNAMIC SUFFIX (Rotasi Harian) --- */
                const months = [
                    "Januari",
                    "Februari",
                    "Maret",
                    "April",
                    "Mei",
                    "Juni",
                    "Juli",
                    "Agustus",
                    "September",
                    "Oktober",
                    "November",
                    "Desember",
                ];
                const d = new Date();

                // 1. Update Judul Event (Bulan)
                const monthEl = document.getElementById("current-month-title");
                if (monthEl) monthEl.innerText = months[d.getMonth()];
                // Mengambil elemen dengan ID 'current-month'
                const promoMonthEl = document.getElementById("current-month");
                // Mengisi hanya dengan Nama Bulan (tanpa Tahun)
                if (promoMonthEl) promoMonthEl.innerText = months[d.getMonth()];
                // 2. Update "Last Update" di Hero
                const dateEl = document.getElementById("auto-date");
                if (dateEl)
                    dateEl.innerText =
                        d.getDate() +
                        " " +
                        months[d.getMonth()] +
                        " " +
                        d.getFullYear();

                // 3. DAILY SUFFIX (Ganti Text Berdasarkan Tanggal)
                function setDailySuffix() {
                    const suffixes = [
                        "Terbaru 2026", // Muncul tanggal 1, 5, 9...
                        "Bonus Saldo Gratis", // Muncul tanggal 2, 6, 10...
                        "Valid & Terverifikasi", // Muncul tanggal 3, 7, 11...
                        "Edisi " + months[d.getMonth()], // Muncul tanggal 4, 8, 12...
                    ];

                    // Ambil tanggal hari ini (angka 1-31)
                    const dateNum = d.getDate();

                    // Rumus Matematika (Modulus): Sisa bagi tanggal dengan jumlah opsi
                    // Hasilnya akan selalu index 0, 1, 2, atau 3.
                    const index = dateNum % suffixes.length;

                    const el = document.getElementById("dynamic-suffix");
                    if (el) {
                        // Set text langsung (Statis seharian)
                        el.innerText = suffixes[index];
                    }
                }
                setDailySuffix();

                /* --- 6. LIGHTBOX IMAGE PREVIEW --- */
                const lb = document.getElementById("lightbox");
                const lbImg = document.getElementById("lightbox-img");
                const lbCap = document.getElementById("lightbox-caption");

                function openLightbox(el) {
                    const img = el.querySelector("img");
                    lbImg.src = img.src;
                    lbCap.innerText =
                        img.getAttribute("data-caption") || img.alt;
                    lb.classList.remove("hidden");
                    setTimeout(() => {
                        lb.classList.remove("opacity-0");
                        lbImg.classList.remove("scale-95");
                        lbImg.classList.add("scale-100");
                    }, 10);
                    document.body.style.overflow = "hidden";
                }

                function closeLightbox() {
                    lb.classList.add("opacity-0");
                    lbImg.classList.remove("scale-100");
                    lbImg.classList.add("scale-95");
                    setTimeout(() => {
                        lb.classList.add("hidden");
                        document.body.style.overflow = "auto";
                    }, 300);
                }

                // Close Lightbox with ESC key
                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape") closeLightbox();
                });

                /* --- 7. SOCIAL PROOF TOAST (Fake Notification) --- */
                const names = [
                    "Budi S.",
                    "Siti A.",
                    "Rizky P.",
                    "Dewi L.",
                    "Andi K.",
                    "Putri M.",
                ];
                const cities = [
                    "Jakarta",
                    "Surabaya",
                    "Bandung",
                    "Medan",
                    "Yogya",
                    "Semarang",
                ];

                function runSocialProof() {
                    const container =
                        document.getElementById("toast-container");
                    if (!container) return;

                    const el = document.createElement("div");
                    el.className = `glass-strong border-l-4 border-shopee p-3 rounded-lg flex items-center gap-3 min-w-[260px] toast-enter pointer-events-auto shadow-2xl`;
                    el.innerHTML = `
            <div class="bg-shopee/20 text-shopee p-1.5 rounded-full"><i class="ph-bold ph-gift"></i></div>
            <div>
                <p class="text-[10px] font-bold text-gray-400 uppercase">Baru Saja</p>
                <p class="text-xs font-medium text-white">${names[Math.floor(Math.random() * names.length)]} dari ${cities[Math.floor(Math.random() * cities.length)]} klaim 5RB</p>
            </div>
        `;
                    container.appendChild(el);

                    requestAnimationFrame(() => {
                        el.classList.remove("toast-enter");
                        el.classList.add("toast-enter-active");
                    });

                    setTimeout(() => {
                        el.classList.remove("toast-enter-active");
                        el.classList.add("toast-exit-active");
                        setTimeout(() => el.remove(), 300);
                    }, 4000);

                    // Random interval antara 7-12 detik
                    setTimeout(
                        runSocialProof,
                        Math.random() * (12000 - 7000) + 7000,
                    );
                }
                // Mulai notifikasi setelah 3 detik
                setTimeout(runSocialProof, 3000);

                /* --- 8. ONLINE USER COUNTER SIMULATION --- */
                setInterval(() => {
                    const el = document.getElementById("online-counter");
                    if (el) {
                        let val = parseInt(el.innerText);
                        val += Math.floor(Math.random() * 5) - 2; // Naik/Turun acak
                        if (val < 90) val = 95; // Batas bawah
                        el.innerText = val;
                    }
                }, 4500);
            </script>
        </article>
    </main>
</body>
</html>
