                <script is:inline>
                    document.addEventListener("DOMContentLoaded", () => {
                        const container =
                            document.getElementById("news-container");

                        // KRITIKAL: Ganti AllOrigins dengan RSS2JSON
                        // Ini mengubah response langsung jadi JSON (lebih cepat diparse) dan servernya lebih ngebut
                        const rssUrl =
                            "https://news.google.com/rss/search?q=ShopeePay+when:30d&hl=id-ID&gl=ID&ceid=ID:id";
                        const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(rssUrl)}`;

                        fetch(apiUrl)
                            .then((response) => {
                                if (response.ok) return response.json();
                                throw new Error("Network response was not ok.");
                            })
                            .then((data) => {
                                // RSS2JSON mengembalikan items dalam array 'items', bukan XML structure
                                const items = data.items;

                                let html = "";
                                // Ambil maksimal 10 berita
                                const maxItems = items
                                    ? Math.min(items.length, 10)
                                    : 0;

                                if (maxItems === 0) {
                                    container.innerHTML =
                                        '<div class="text-center text-gray-500 text-sm py-4">Belum ada berita terbaru minggu ini.</div>';
                                    return;
                                }

                                for (let i = 0; i < maxItems; i++) {
                                    const item = items[i];

                                    // Logic pemisah Judul - Source
                                    let source = "Media Nasional";
                                    let title = item.title;

                                    // Google RSS via JSON kadang formatnya sedikit beda, kita handle aman
                                    if (title.includes(" - ")) {
                                        const parts = title.split(" - ");
                                        // Cek kalau bagian terakhir pendek (kemungkinan nama media)
                                        if (
                                            parts[parts.length - 1].length < 20
                                        ) {
                                            source = parts.pop();
                                        }
                                        title = parts.join(" - ");
                                    }

                                    // Format Tanggal (RSS2JSON mengembalikan format "YYYY-MM-DD HH:mm:ss")
                                    // Kita perlu ubah string ini ke Date object yang valid untuk Safari/Mobile
                                    const dateStrRaw = item.pubDate.replace(
                                        /-/g,
                                        "/",
                                    ); // Fix untuk kompatibilitas browser lama
                                    const dateObj = new Date(dateStrRaw);
                                    const dateStr = dateObj.toLocaleDateString(
                                        "id-ID",
                                        {
                                            day: "numeric",
                                            month: "short",
                                            year: "numeric",
                                        },
                                    );

                                    html += `
                        <a href="${item.link}" target="_blank" rel="nofollow noopener" class="group block bg-white/5 hover:bg-white/10 border border-white/5 hover:border-shopee/30 p-5 rounded-xl transition-all duration-300 relative overflow-hidden">
                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 md:gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="text-[10px] font-bold text-shopee bg-shopee/10 px-2 py-0.5 rounded border border-shopee/10">${source}</span>
                                        <span class="text-[10px] text-gray-500 flex items-center gap-1"><i class="ph-fill ph-clock"></i> ${dateStr}</span>
                                    </div>
                                    <h3 class="text-white font-medium text-sm md:text-base leading-snug group-hover:text-shopee transition-colors line-clamp-2">
                                        ${title}
                                    </h3>
                                </div>
                                <div class="shrink-0 mt-2 md:mt-0">
                                    <span class="text-xs text-gray-500 group-hover:text-white flex items-center gap-1 bg-black/20 px-3 py-1.5 rounded-lg border border-white/5">
                                        Baca <i class="ph-bold ph-caret-right"></i>
                                    </span>
                                </div>
                            </div>
                        </a>
                    `;
                                }
                                container.innerHTML = html;
                            })
                            .catch((error) => {
                                console.error("Error fetching news:", error);
                                // Fallback UI yang lebih bersih
                                container.innerHTML = `
                    <div class="text-center bg-red-500/10 border border-red-500/20 rounded-xl p-4">
                        <p class="text-red-400 text-sm">Gagal memuat berita saat ini.</p>
                        <button onclick="location.reload()" class="mt-2 text-xs text-white bg-white/10 px-3 py-1 rounded hover:bg-white/20 transition">Coba Refresh</button>
                    </div>
                `;
                            });
                    });
                </script>
