    <div id="modal-privacy" class="fixed inset-0 z-[100] hidden"><div class="absolute inset-0 bg-black/90 backdrop-blur-sm" onclick="toggleModal('modal-privacy')"></div><div class="relative z-10 w-full max-w-2xl mx-auto mt-20 px-4"><div class="bg-[#0f0f0f] border border-white/10 rounded-2xl p-6"><h2 class="text-white font-bold mb-4">Privacy Policy</h2><p class="text-gray-400 text-sm">Data aman. Kami tidak menyimpan data pribadi.</p><button onclick="toggleModal('modal-privacy')" class="mt-4 text-shopee">Tutup</button></div></div></div>
    <div id="modal-terms" class="fixed inset-0 z-[100] hidden"><div class="absolute inset-0 bg-black/90 backdrop-blur-sm" onclick="toggleModal('modal-terms')"></div><div class="relative z-10 w-full max-w-2xl mx-auto mt-20 px-4"><div class="bg-[#0f0f0f] border border-white/10 rounded-2xl p-6"><h2 class="text-white font-bold mb-4">Terms & Conditions</h2><p class="text-gray-400 text-sm">Gunakan kode dengan bijak.</p><button onclick="toggleModal('modal-terms')" class="mt-4 text-shopee">Tutup</button></div></div></div>

