            </div>
        </div>
    </div>

    <script is:inline>
        /* --- CONFIG --- */
        const currentCode = "SPL2120960001886617649";
        const targetUrl = "https://id.shp.ee/33lfyx0";

        /* --- FUNCTIONS --- */
        function copyCode() {
            if (navigator.vibrate) navigator.vibrate(50);
            
            // Logic Copy
            if (!navigator.clipboard) {
                const ta = document.createElement("textarea");
                ta.value = currentCode;
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
            } else {
                navigator.clipboard.writeText(currentCode);
            }

            // Show Modal
            const modal = document.getElementById('modal-confirm-redirect');
            modal.classList.remove('hidden');
            
            // Auto Redirect (Optional, delay 1s)
            // setTimeout(() => window.open(targetUrl, '_blank'), 1500);
        }

        function closeConfirmModal() {
            document.getElementById('modal-confirm-redirect').classList.add('hidden');
        }

        function toggleAccordion(btn) {
            const content = btn.nextElementSibling;
            const icon = btn.querySelector('.ph-caret-down');
            content.classList.toggle('active');
            btn.parentElement.classList.toggle('active');
            icon.style.transform = content.classList.contains('active') ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        /* --- UI EFFECTS --- */
        const nav = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if(window.scrollY > 50) nav.classList.add('shadow-lg', 'bg-black/90');
            else nav.classList.remove('shadow-lg', 'bg-black/90');
        });

        // Fake Counter
        setInterval(() => {
            const el = document.getElementById('online-counter');
            if(el) {
                let val = parseInt(el.innerText);
                val += Math.floor(Math.random() * 5) - 2; 
                el.innerText = val < 200 ? 205 : val;
            }
        }, 4500);
    </script>
</body>
